views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "Attachments"
        - file.ext != "base"
    order:
      - file.name
      - file.ext
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    imageAspectRatio: 1.2
    image: file.file
